# ESP32-C6 – Zigbee Coordinator + Radar → UART Bridge
# Kein WiFi, kein MQTT – Ausgabe über UART0 (GPIO16/17)

# ── Zigbee ────────────────────────────────────────────────────────────────────
CONFIG_ZB_ENABLED=y
CONFIG_ZB_COORDINATOR_ROLE=y
CONFIG_ZB_GP_ENABLED=n

# ── CPU / System ──────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ── Console → USB_SERIAL_JTAG (UART0 bleibt frei für S3-Verbindung) ──────────
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Flash / Partition Table ───────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── NVS ───────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ── Logging ───────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
